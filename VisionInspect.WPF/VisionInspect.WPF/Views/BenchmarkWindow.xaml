<Window x:Class="VisionInspect.WPF.Views.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionInspect.WPF.Controls"
        Title="VisionInspect - Benchmark"
        Width="1600"
        Height="950"
        MinWidth="1250"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="#10151E"
        Foreground="#E5EAF2">

	<Window.Resources>
		<SolidColorBrush x:Key="PanelBrush" Color="#192330"/>

		<Style x:Key="PanelStyle" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource PanelBrush}"/>
			<Setter Property="CornerRadius" Value="9"/>
			<Setter Property="Padding" Value="15"/>
		</Style>

		<Style x:Key="ActionButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#263445"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="15,7"/>
			<Setter Property="MinHeight" Value="34"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<Style x:Key="CaptionStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#91A1B5"/>
			<Setter Property="FontSize" Value="11"/>
		</Style>

		<Style x:Key="DarkColumnHeaderStyle"
               TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#253548"/>
			<Setter Property="Foreground" Value="#DCE7F4"/>
			<Setter Property="Padding" Value="10,9"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style x:Key="DarkRowStyle" TargetType="DataGridRow">
			<Setter Property="Background" Value="#192330"/>
			<Setter Property="Foreground" Value="#E5EAF2"/>
			<Setter Property="MinHeight" Value="34"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Style.Triggers>
				<Trigger Property="AlternationIndex" Value="1">
					<Setter Property="Background" Value="#202D3D"/>
				</Trigger>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="#234B6B"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DarkCellStyle" TargetType="DataGridCell">
			<Setter Property="Foreground" Value="#E5EAF2"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="10,6"/>
		</Style>

		<Style x:Key="DarkCellTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#E5EAF2"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="55"/>
			<RowDefinition Height="78"/>
			<RowDefinition Height="310"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="220"/>
			<RowDefinition Height="25"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<Grid Grid.Row="0" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
				<TextBlock Text="VISION"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#58B9FF"/>
				<TextBlock Text="INSPECT"
                           FontSize="24"
                           FontWeight="Bold"/>
				<TextBlock Text="  / PERFORMANCE ANALYTICS"
                           FontSize="12"
                           Foreground="#91A1B5"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,4"/>
			</StackPanel>

			<StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
				<Button Content="BACK TO INSPECTION"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0"
                        Click="Back_Click"/>
				<Button Content="REFRESH"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#1675C5"
                        Command="{Binding RefreshCommand}"/>
			</StackPanel>
		</Grid>

		<!-- DATASET INFO -->
		<Border Grid.Row="1"
                Style="{StaticResource PanelStyle}"
                Margin="0,0,0,10">
			<UniformGrid Columns="4">
				<StackPanel>
					<TextBlock Text="DATASET"
                               Style="{StaticResource CaptionStyle}"/>
					<TextBlock Text="{Binding DatasetName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
				</StackPanel>
				<StackPanel>
					<TextBlock Text="CATEGORY"
                               Style="{StaticResource CaptionStyle}"/>
					<TextBlock Text="{Binding CategoryName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
				</StackPanel>
				<StackPanel>
					<TextBlock Text="DEVICE"
                               Style="{StaticResource CaptionStyle}"/>
					<TextBlock Text="{Binding DeviceName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
				</StackPanel>
				<StackPanel>
					<TextBlock Text="EVALUATED AT"
                               Style="{StaticResource CaptionStyle}"/>
					<TextBlock Text="{Binding CreatedAtText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
				</StackPanel>
			</UniformGrid>
		</Border>

		<!-- TOP 3 COLUMNS -->
		<Grid Grid.Row="2" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<!-- BENCHMARK SUMMARY -->
				<ColumnDefinition Width="1*"/>

				<ColumnDefinition Width="10"/>

				<!-- MODEL STRENGTHS -->
				<ColumnDefinition Width="1*"/>

				<ColumnDefinition Width="10"/>

				<!-- FULL EVALUATION TIME -->
				<ColumnDefinition Width="2*"/>
			</Grid.ColumnDefinitions>
			<!-- SUMMARY -->
			<Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Text="BENCHMARK SUMMARY"
                               FontSize="14"
                               FontWeight="Bold"/>

					<StackPanel Grid.Row="1"
                                VerticalAlignment="Center">
						<TextBlock Text="BEST IMAGE AUROC"
                                   Style="{StaticResource CaptionStyle}"/>
						<TextBlock Text="{Binding BestImageModel}"
                                   Foreground="#38BDF8"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
					</StackPanel>

					<StackPanel Grid.Row="2"
                                VerticalAlignment="Center">
						<TextBlock Text="BEST PIXEL AUROC"
                                   Style="{StaticResource CaptionStyle}"/>
						<TextBlock Text="{Binding BestPixelModel}"
                                   Foreground="#A78BFA"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
					</StackPanel>

					<StackPanel Grid.Row="3"
                                VerticalAlignment="Center">
						<TextBlock Text="FASTEST EVALUATION"
                                   Style="{StaticResource CaptionStyle}"/>
						<TextBlock Text="{Binding FastestModel}"
                                   Foreground="#34D399"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
					</StackPanel>
				</Grid>
			</Border>

			<!-- RADAR -->
			<Border Grid.Column="2"
                    Style="{StaticResource PanelStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Text="MODEL STRENGTHS"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

					<controls:BenchmarkCharts
                        Grid.Row="1"
                        ChartType="Radar"
                        Results="{Binding ChartResults, Mode=OneWay}"/>
				</Grid>
			</Border>

			<!-- SPEED -->
			<Border Grid.Column="4"
                    Style="{StaticResource PanelStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Text="FULL EVALUATION TIME"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

					<controls:BenchmarkCharts
                        Grid.Row="1"
                        ChartType="SpeedBar"
                        Results="{Binding ChartResults, Mode=OneWay}"/>
				</Grid>
			</Border>
		</Grid>

		<!-- PERFORMANCE -->
		<Border Grid.Row="3"
                Style="{StaticResource PanelStyle}"
                Margin="0,0,0,10">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<TextBlock Text="PERFORMANCE COMPARISON"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

				<StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
					<TextBlock Text="● PatchCore"
                               Foreground="#38BDF8"
                               Margin="0,0,20,0"/>
					<TextBlock Text="● PaDiM"
                               Foreground="#A78BFA"
                               Margin="0,0,20,0"/>
					<TextBlock Text="● EfficientAD"
                               Foreground="#34D399"/>
				</StackPanel>

				<controls:BenchmarkCharts
                    Grid.Row="2"
                    ChartType="GroupedBar"
                    Results="{Binding ChartResults, Mode=OneWay}"/>
			</Grid>
		</Border>

		<!-- DETAILED RESULTS -->
		<Border Grid.Row="4"
                Style="{StaticResource PanelStyle}"
                Margin="0,0,0,10">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<TextBlock Text="DETAILED RESULTS"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

				<DataGrid Grid.Row="1"
                          ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Background="#192330"
                          Foreground="#E5EAF2"
                          BorderBrush="#34465B"
                          BorderThickness="1"
                          GridLinesVisibility="None"
                          AlternationCount="2"
                          ColumnHeaderStyle="{StaticResource DarkColumnHeaderStyle}"
                          RowStyle="{StaticResource DarkRowStyle}"
                          CellStyle="{StaticResource DarkCellStyle}">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Algorithm"
                                            Binding="{Binding ModelName}"
                                            ElementStyle="{StaticResource DarkCellTextStyle}"
                                            Width="*"/>
						<DataGridTextColumn Header="Image AUROC"
                                            Binding="{Binding ImageAUROCText}"
                                            ElementStyle="{StaticResource DarkCellTextStyle}"
                                            Width="*"/>
						<DataGridTextColumn Header="Image F1"
                                            Binding="{Binding ImageF1Text}"
                                            ElementStyle="{StaticResource DarkCellTextStyle}"
                                            Width="*"/>
						<DataGridTextColumn Header="Pixel AUROC"
                                            Binding="{Binding PixelAUROCText}"
                                            ElementStyle="{StaticResource DarkCellTextStyle}"
                                            Width="*"/>
						<DataGridTextColumn Header="Pixel F1"
                                            Binding="{Binding PixelF1Text}"
                                            ElementStyle="{StaticResource DarkCellTextStyle}"
                                            Width="*"/>
						<DataGridTextColumn Header="Eval Time"
                                            Binding="{Binding EvaluationTimeText}"
                                            ElementStyle="{StaticResource DarkCellTextStyle}"
                                            Width="*"/>
						<DataGridTextColumn Header="Status"
                                            Binding="{Binding StatusText}"
                                            ElementStyle="{StaticResource DarkCellTextStyle}"
                                            Width="*"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
		</Border>

		<!-- STATUS -->
		<TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   Foreground="#91A1B5"
                   VerticalAlignment="Center"/>
	</Grid>
</Window>
